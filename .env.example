# Shopee Afiliados (obrigatório para buscar o produto pelo link)
SHOPEE_APP_ID=seu_app_id_aqui
SHOPEE_SECRET=seu_secret_aqui

# Vídeo HD com IA (opcional) — escolha 'fal' ou 'kling' (ou deixe vazio: usa o que tiver chave)
VIDEO_PROVIDER=
# Opção A: fal.ai — chave em https://fal.ai/dashboard/keys
FAL_KEY=
# Modelo imagem→vídeo do fal.ai (opcional; padrão: fal-ai/kling-video/v2.1/pro/image-to-video)
FAL_MODEL=
# Opção B: Kling AI direto (API oficial) — Access Key + Secret Key do painel de desenvolvedor
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
# opcional (padrão: kling-v2-6 e https://api-singapore.klingai.com)
KLING_MODEL=
KLING_BASE_URL=

# Narração com voz dentro do vídeo (opcional) — 'gemini' ou 'openai' (ou vazio: usa o que tiver chave)
TTS_PROVIDER=
# Google AI Studio (grátis p/ uso leve) — chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_VOICE=Leda
GEMINI_TTS_MODEL=
# OpenAI
OPENAI_API_KEY=
TTS_VOICE=nova

# Só se hospedar publicamente (obrigatório nesse caso)
APP_PASSWORD=
